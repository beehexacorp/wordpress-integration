#: src/UI/AdminConnectionGuidePage.php:29
msgid "Connect WooCommerce to HexaSync"
msgstr "Kết nối WooCommerce với HexaSync"

#: src/UI/AdminConnectionGuidePage.php:31
msgid "Follow this setup guide to connect your WooCommerce store with HexaSync for product, order, and customer sync."
msgstr "Làm theo hướng dẫn này để kết nối cửa hàng WooCommerce với HexaSync, đồng bộ sản phẩm, đơn hàng và khách hàng."

#: src/UI/AdminConnectionGuidePage.php:35
msgid "Step 1: Prepare your store"
msgstr "Bước 1: Chuẩn bị cửa hàng"

#: src/UI/AdminConnectionGuidePage.php:37
msgid "Make sure WooCommerce is installed and active."
msgstr "Đảm bảo WooCommerce đã được cài đặt và kích hoạt."

#: src/UI/AdminConnectionGuidePage.php:38
msgid "Confirm your store can access the internet and WordPress cron is running."
msgstr "Xác nhận cửa hàng truy cập được Internet và WordPress cron đang chạy."

#: src/UI/AdminConnectionGuidePage.php:39
msgid "Ensure your site uses HTTPS for secure API communication."
msgstr "Đảm bảo trang web dùng HTTPS để giao tiếp API an toàn."

#: src/UI/AdminConnectionGuidePage.php:44
msgid "Step 2: Create WooCommerce API keys"
msgstr "Bước 2: Tạo khóa API WooCommerce"

#. translators: %s: URL of the WooCommerce REST API keys screen
#: src/UI/AdminConnectionGuidePage.php:48
msgid "Open <a href=\"%s\">WooCommerce REST API keys</a>."
msgstr "Mở trang <a href=\"%s\">khóa REST API của WooCommerce</a>."

#: src/UI/AdminConnectionGuidePage.php:50
msgid "Click <strong>Add key</strong>."
msgstr "Nhấn <strong>Add key</strong> (Thêm khóa)."

#: src/UI/AdminConnectionGuidePage.php:51
msgid "Set permissions to <strong>Read/Write</strong>."
msgstr "Đặt quyền là <strong>Read/Write</strong> (Đọc/Ghi)."

#: src/UI/AdminConnectionGuidePage.php:52
msgid "Copy the <strong>Consumer key</strong> and <strong>Consumer secret</strong>."
msgstr "Sao chép <strong>Consumer key</strong> và <strong>Consumer secret</strong>."

#: src/UI/AdminConnectionGuidePage.php:54
msgid "Keep both keys secure. You will add them in HexaSync connection settings."
msgstr "Hãy giữ bí mật cả hai khóa. Bạn sẽ nhập chúng trong phần cài đặt kết nối của HexaSync."

#: src/UI/AdminConnectionGuidePage.php:58
msgid "Step 3: Connect in HexaSync"
msgstr "Bước 3: Kết nối trong HexaSync"

#: src/UI/AdminConnectionGuidePage.php:60
msgid "Log in to your HexaSync workspace."
msgstr "Đăng nhập vào không gian làm việc HexaSync của bạn."

#: src/UI/AdminConnectionGuidePage.php:61
msgid "Create a new profile and choose WooCommerce as source or destination."
msgstr "Tạo profile mới và chọn WooCommerce làm nguồn hoặc đích."

#: src/UI/AdminConnectionGuidePage.php:62
msgid "Enter your store URL, Consumer key, and Consumer secret."
msgstr "Nhập URL cửa hàng, Consumer key và Consumer secret."

#: src/UI/AdminConnectionGuidePage.php:63
msgid "Run the connection test and save when it succeeds."
msgstr "Chạy kiểm tra kết nối và lưu lại khi thành công."

#: src/UI/AdminConnectionGuidePage.php:68
msgid "Step 4: Optional webhook setup"
msgstr "Bước 4: Thiết lập webhook (không bắt buộc)"

#. translators: %s: URL of the WooCommerce webhooks screen
#: src/UI/AdminConnectionGuidePage.php:72
msgid "Open <a href=\"%s\">WooCommerce Webhooks</a>."
msgstr "Mở trang <a href=\"%s\">Webhook của WooCommerce</a>."

#: src/UI/AdminConnectionGuidePage.php:74
msgid "Create webhooks for events you want to sync in near real time (for example: order created/updated)."
msgstr "Tạo webhook cho các sự kiện cần đồng bộ gần như tức thời (ví dụ: đơn hàng được tạo/cập nhật)."

#: src/UI/AdminConnectionGuidePage.php:75
msgid "Use the webhook URL provided by your HexaSync flow."
msgstr "Dùng URL webhook do luồng HexaSync của bạn cung cấp."

#: src/UI/AdminConnectionGuidePage.php:80
msgid "Troubleshooting checklist"
msgstr "Danh sách kiểm tra khi gặp sự cố"

#: src/UI/AdminConnectionGuidePage.php:82
msgid "API key permissions are Read/Write."
msgstr "Khóa API có quyền Read/Write (Đọc/Ghi)."

#: src/UI/AdminConnectionGuidePage.php:83
msgid "Store URL in HexaSync exactly matches your WordPress site URL."
msgstr "URL cửa hàng trong HexaSync khớp chính xác với URL trang WordPress."

#: src/UI/AdminConnectionGuidePage.php:84
msgid "No firewall or security plugin blocks incoming/outgoing API requests."
msgstr "Không có tường lửa hay plugin bảo mật nào chặn yêu cầu API đến/đi."

#: src/UI/AdminConnectionGuidePage.php:85
msgid "Server time and timezone are correct."
msgstr "Thời gian và múi giờ của máy chủ chính xác."

#. translators: %s: URL of the HexaSync Logs admin page
#: src/UI/AdminConnectionGuidePage.php:92
msgid "Need sync history and debug details? Go to <a href=\"%s\">HexaSync Logs</a>."
msgstr "Cần xem lịch sử đồng bộ và chi tiết lỗi? Vào <a href=\"%s\">Nhật ký HexaSync</a>."

